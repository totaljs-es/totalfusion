{
	"name": "totalfusion",
	"version": "0.1.0",
	"description": "Extends Total.js with Python, Rust, Go and WebAssembly: supervised workers, contracts that become actions and MCP tools, streaming, binary data and development reload.",
	"keywords": [
		"totaljs",
		"total.js",
		"python",
		"rust",
		"go",
		"webassembly",
		"wasm",
		"sandbox",
		"worker",
		"workers",
		"ipc",
		"mcp",
		"ai",
		"machine-learning",
		"streaming",
		"interop"
	],
	"homepage": "https://github.com/totaljs-es/totalfusion#readme",
	"bugs": {
		"url": "https://github.com/totaljs-es/totalfusion/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/totaljs-es/totalfusion.git"
	},
	"author": "Spanish Total.js Platform",
	"license": "MIT",
	"main": "index.js",
	"bin": {
		"totalfusion": "bin/totalfusion.js"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"index.js",
		"bin",
		"docs",
		"lib",
		"python",
		"total5",
		"scripts/flow-db.js",
		"rust/index.js",
		"rust/Cargo.toml",
		"rust/README.md",
		"rust/src",
		"rust/AGENTS.md",
		"go/index.js",
		"go/go.mod",
		"go/README.md",
		"go/*.go",
		"go/AGENTS.md",
		"wasm/index.js",
		"wasm/host.js",
		"wasm/AGENTS.md",
		"!go/*_test.go",
		"CHANGELOG.md",
		"AGENTS.md",
		"llms.txt",
		"schemas",
		"!**/__pycache__",
		"!**/*.pyc"
	],
	"scripts": {
		"test": "node --test",
		"test:rust": "cargo test --manifest-path rust/Cargo.toml",
		"test:go": "cd go && go test ./...",
		"prepublishOnly": "npm run check",
		"check": "node --test tests/docs.test.js tests/agents.test.js tests/package.test.js",
		"generate": "node scripts/llms.js --write && node scripts/flow-db.js --write"
	}
}
